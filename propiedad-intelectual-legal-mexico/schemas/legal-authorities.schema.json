{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soft.law/schemas/ip-mx/legal-authorities.schema.json",
  "type": "object",
  "required": ["schema_version", "as_of", "authorities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "authority_type", "issuing_body", "official_url", "publication_date", "effective_date_status", "retrieved_at", "content_hash_status", "status", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^MX-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "authority_type": {"enum": ["statute", "regulation", "reform_decree", "official_guidance"]},
          "issuing_body": {"type": "string", "minLength": 1},
          "official_url": {"type": "string", "pattern": "^https://(www\\.diputados\\.gob\\.mx|sidof\\.segob\\.gob\\.mx)/"},
          "publication_date": {"type": "string", "format": "date"},
          "latest_reform_date": {"type": ["string", "null"], "format": "date"},
          "effective_from": {"type": ["string", "null"], "format": "date"},
          "effective_date_status": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date"},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "content_hash_status": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
