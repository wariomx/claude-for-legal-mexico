{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soft.law/schemas/ip-mx/verified-rules.schema.json",
  "type": "object",
  "required": ["schema_version", "as_of", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "proposition", "authority_refs", "status", "last_verified", "next_review", "requires_human_review"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^MX-(LFPPI|LFDA|LFT|CPF|LRART5)-[A-Z0-9-]+-[0-9]{3}$"},
          "topic": {"type": "string", "minLength": 1},
          "proposition": {"type": "string", "minLength": 20},
          "authority_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["authority_id", "pinpoint"],
              "additionalProperties": false,
              "properties": {
                "authority_id": {"type": "string"},
                "pinpoint": {"type": "string", "minLength": 1}
              }
            }
          },
          "status": {"type": "string", "pattern": "^verified_primary"},
          "last_verified": {"type": "string", "format": "date"},
          "next_review": {"type": "string", "format": "date"},
          "requires_human_review": {"type": "boolean"}
        }
      }
    }
  }
}
