{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soft.law/schemas/ip-mx/connector-capabilities.schema.json",
  "type": "object",
  "required": ["schema_version", "as_of", "dependency", "status_model", "connectors", "unsupported_capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "format": "date"},
    "dependency": {
      "type": "object",
      "required": ["plugin", "minimum_reviewed_version", "source_manifest", "source_manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "plugin": {"type": "string", "minLength": 1},
        "minimum_reviewed_version": {"type": "string", "minLength": 1},
        "source_manifest": {"type": "string", "minLength": 1},
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "status_model": {
      "type": "object",
      "required": ["verified", "partially_verified", "configured_unverified", "unavailable", "unsupported"],
      "additionalProperties": false,
      "properties": {
        "verified": {"type": "string", "minLength": 1},
        "partially_verified": {"type": "string", "minLength": 1},
        "configured_unverified": {"type": "string", "minLength": 1},
        "unavailable": {"type": "string", "minLength": 1},
        "unsupported": {"type": "string", "minLength": 1}
      }
    },
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "declared_server", "expected_manifest", "capabilities", "authentication", "runtime_probe", "write_capabilities_assumed"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "declared_server": {"type": "string", "minLength": 1},
          "expected_manifest": {
            "type": "object",
            "required": ["type", "url"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "http"},
              "url": {"type": "string", "pattern": "^https://"}
            }
          },
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
          "authentication": {"type": "string", "minLength": 1},
          "runtime_probe": {"type": "string", "minLength": 1},
          "write_capabilities_assumed": {"const": false},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "unsupported_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "examples", "status", "fallback", "rule"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "examples": {"type": "array", "items": {"type": "string"}},
          "status": {"const": "unsupported"},
          "fallback": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
