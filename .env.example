# ============================================================================
# claude-for-legal-mexico — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Note: LegalDataHunter API key is no longer configured here.
# Use: claude plugin configure conectores-legal-mexico@claude-for-legal
# The key is stored securely in the system keychain via plugin userConfig.
# ============================================================================

# --- Portal Ciudadano CJJ (Consejo de la Judicatura de Jalisco) ---
# Used by: litigacion-legal-mexico (boletin-monitor, revision-expedientes-jalisco, vigilante-expedientes)
# Register at: https://ciudadano.cjj.gob.mx
# Note: The bulletin API (api.cjj.gob.mx) is public and needs no credentials.
#       These credentials are for the authenticated Nilo API (nilo.cjj.gob.mx).
CJJ_NILO_EMAIL=
CJJ_NILO_PASSWORD=
CJJ_NILO_PUBLIC_TOKEN=
